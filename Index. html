  const text = document.getElementById("captionText").value;
  const color = document.getElementById("captionColor").value;
  const size = document.getElementById("captionSize").value;

  const display = document.getElementById("captionDisplay");

  display.textContent = text;
  display.style.color = color;
  display.style.fontSize = size + "px";
}

function removeCaption() {
  document.getElementById("captionDisplay").textContent = "";
  document.getElementById("captionText").value = "";
}
