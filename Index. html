<div class="panel">
  <h2>✂️ Timeline & Trim</h2>

  <div style="background:#292631;padding:12px;border-radius:10px">
    <div style="color:#ff762e;font-weight:bold;margin-bottom:10px">
      VIDEO TRACK
    </div>

    <input id="trimStart" type="range"
      min="0" max="100" value="0"
      style="width:100%">

    <input id="trimEnd" type="range"
      min="0" max="100" value="100"
      style="width:100%">

    <p id="trimInfo" class="muted">
      Start: 0% | End: 100%
    </p>
  </div>

  <div class="actions">
    <button onclick="previewTrim()">▶ Preview Trim</button>
    <button onclick="resetTrim()">↺ Reset</button>
  </div>
</div>

<script>
const trimStart = document.getElementById("trimStart");
const trimEnd = document.getElementById("trimEnd");
const trimInfo = document.getElementById("trimInfo");
const videoPreview = document.getElementById("videoPreview");

function updateTrimInfo() {
  let start = Number(trimStart.value);
  let end = Number(trimEnd.value);

  if (start >= end) {
    end = start + 1;
    trimEnd.value = end;
  }

  trimInfo.textContent =
    "Start: " + start + "% | End: " + end + "%";
}

trimStart.addEventListener("input", updateTrimInfo);
trimEnd.addEventListener("input", updateTrimInfo);

function previewTrim() {
  if (!videoPreview.duration) {
    alert("Import a video first.");
    return;
  }

  const start = Number(trimStart.value) / 100;
  const end = Number(trimEnd.value) / 100;

  videoPreview.currentTime = videoPreview.duration * start;
  videoPreview.play();

  videoPreview.ontimeupdate = function() {
    if (videoPreview.currentTime >= videoPreview.duration * end) {
      videoPreview.pause();
      videoPreview.ontimeupdate = null;
    }
  };
}

function resetTrim() {
  trimStart.value = 0;
  trimEnd.value = 100;
  updateTrimInfo();

  if (videoPreview.duration) {
    videoPreview.currentTime = 0;
  }
}
</script>

