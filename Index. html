<div class="panel">
  <h2>🎬 Video Preview</h2>

  <video id="videoPreview"
    controls
    playsinline
    style="width:100%;background:#000;border-radius:10px;max-height:350px">
  </video>

  <div class="actions">
    <button class="primary"
      onclick="document.getElementById('videoInput').click()">
      📁 Import Video
    </button>

    

  <p id="videoStatus" class="muted">
    No video imported. Choose a video from your gallery.
  </p>
</div>

<script>
let currentVideo = null;

function loadVideo(event) {
  const file = event.target.files[0];
  if (!file) return;

  if (file.size > 5 * 1024 * 1024 * 1024) {
    alert("This video is too large.");
    return;
  }

  const video = document.getElementById("videoPreview");

  if (currentVideo) {
    URL.revokeObjectURL(currentVideo);
  }

  currentVideo = URL.createObjectURL(file);
  video.src = currentVideo;

  video.load();

  document.getElementById("videoStatus").textContent =
    "Imported: " + file.name;
}
</script>
