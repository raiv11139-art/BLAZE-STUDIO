<script>
function playVideo() {
  document.getElementById("videoPreview").play();
}

function pauseVideo() {
  document.getElementById("videoPreview").pause();
}

function rewindVideo() {
  const video = document.getElementById("videoPreview");
  video.currentTime = Math.max(0, video.currentTime - 5);
}

function forwardVideo() {
  const video = document.getElementById("videoPreview");
  video.currentTime = Math.min(
    video.duration || 0,
    video.currentTime + 5
  );
}

function splitMarker() {
  const video = document.getElementById("videoPreview");

  if (!video.duration) {
    alert("Import a video first.");
    return;
  }

  document.getElementById("toolbarStatus").textContent =
    "Split marker at " +
    video.currentTime.toFixed(2) +
    " seconds. Actual splitting requires a video editing engine.";
}
</script>

