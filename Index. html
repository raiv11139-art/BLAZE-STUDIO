<div class="panel">
  <h2>🤖 AI Voice Studio</h2>

  <textarea id="ttsText"
    placeholder="Type anything to convert into speech..."
    style="width:100%;min-height:80px"></textarea>

  <label>Voice</label>
  <select id="ttsVoice" style="width:100%">
    <option value="female">Female</option>
    <option value="male">Male</option>
  </select>

  <label>Voice Age / Style</label>
  <select id="ttsAge" style="width:100%">
    <option value="young">Young</option>
    <option value="adult" selected>Adult</option>
    <option value="mature">Mature / Deep</option>
  </select>

  <label>Emotion</label>
  <select id="ttsEmotion" style="width:100%">
    <option value="normal">Normal</option>
    <option value="happy">Happy</option>
    <option value="sad">Sad</option>
    <option value="angry">Angry</option>
    <option value="excited">Excited</option>
    <option value="calm">Calm</option>
  </select>

  <label>Speech Speed</label>
  <input id="ttsRate" type="range"
    min="0.5" max="2" step="0.1" value="1"
    style="width:100%">

  <div class="actions">
    <button class="primary" onclick="speakText()">▶ Generate Voice</button>
    <button onclick="stopSpeech()">⏹ Stop</button>
  </div>

  <p class="muted" id="ttsStatus">
    Voices available depend on your device and browser.
  </p>
</div>

<script>
function speakText() {
  const text = document.getElementById("ttsText").value;

  if (!text.trim()) {
    alert("Enter text first.");
    return;
  }

  if (!("speechSynthesis" in window)) {
    alert("Text-to-speech is not supported in this browser.");
    return;
  }

  speechSynthesis.cancel();

  const utterance = new SpeechSynthesisUtterance(text);

  const voices = speechSynthesis.getVoices();
  const gender = document.getElementById("ttsVoice").value;
  const age = document.getElementById("ttsAge").value;
  const emotion = document.getElementById("ttsEmotion").value;

  let matchingVoice = voices.find(v => {
    const name = v.name.toLowerCase();
    return gender === "female"
      ? /female|woman|girl/.test(name)
      : /male|man|boy/.test(name);
  });

  if (matchingVoice) {
    utterance.voice = matchingVoice;
  }

  let pitch = gender === "female" ? 1.2 : 0.8;
  let rate = Number(document.getElementById("ttsRate").value);

  if (age === "young") {
    pitch += 0.3;
    rate += 0.1;
  }

  if (age === "mature") {
    pitch -= 0.3;
    rate -= 0.1;
  }

  if (emotion === "happy" || emotion === "excited") {
    pitch += 0.3;
    rate += 0.2;
  }

  if (emotion === "sad" || emotion === "calm") {
    pitch -= 0.2;
    rate -= 0.2;
  }

  if (emotion === "angry") {
    pitch += 0.1;
    rate += 0.3;
  }

  utterance.pitch = Math.max(0.1, Math.min(2, pitch));
  utterance.rate = Math.max(0.1, Math.min(2, rate));

  utterance.onstart = () => {
    document.getElementById("ttsStatus").textContent =
      "Speaking...";
  };

  utterance.onend = () => {
    document.getElementById("ttsStatus").textContent =
      "Voice finished.";
  };

  speechSynthesis.speak(utterance);
}

function stopSpeech() {
  speechSynthesis.cancel();

  document.getElementById("ttsStatus").textContent =
    "Voice stopped.";
}

speechSynthesis.onvoiceschanged = function() {
  speechSynthesis.getVoices();
};
</script>

