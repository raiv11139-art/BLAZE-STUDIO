<script>
const originalLoadVideo = loadVideo;

loadVideo = function(event) {
  const file = event.target.files[0];
  if (!file) return;

  const video = document.getElementById("videoPreview");

  video.onloadedmetadata = function() {
    if (video.duration > 25 * 60) {
      alert(
        "FREE EDITION LIMIT: Videos longer than 25 minutes are not supported. Upgrade to Premium for longer projects."
      );

      video.pause();
      video.removeAttribute("src");
      video.load();

      if (currentVideo) {
        URL.revokeObjectURL(currentVideo);
        currentVideo = null;
      }

      document.getElementById("videoStatus").textContent =
        "Video rejected: Free Edition limit is 25 minutes.";

      return;
    }

    document.getElementById("videoStatus").textContent =
      "Video ready: " + Math.floor(video.duration / 60) +
      " minutes " + Math.floor(video.duration % 60) +
      " seconds.";
  };

  originalLoadVideo(event);
};
</script>

