<div class="panel">
  <h2>🎤 Voice-to-Text</h2>

  <p class="muted">
    Automatically recognize speech and turn it into text.
  </p>

  <label>Language</label>
  <select id="sttLanguage" style="width:100%">
    <option value="en-US">English</option>
    <option value="en-GB">English (UK)</option>
    <option value="hi-IN">Hindi</option>
    <option value="ne-NP">Nepali</option>
  </select>

  <div class="actions">
    <button class="primary" onclick="startSTT()">
      🔴 Start Voice-to-Text
    </button>
    <button onclick="stopSTT()">⏹ Stop</button>
  </div>

  <textarea id="sttOutput"
    placeholder="Recognized speech will appear here..."
    style="width:100%;min-height:120px;margin-top:12px"></textarea>

  <div class="actions">
    <button onclick="copySTT()">Copy Captions</button>
    <button onclick="sendSTTToCaption()">Use as Video Text</button>
  </div>

  <p id="sttStatus" class="muted">
    Ready.
  </p>
</div>

<script>
let recognition;

function startSTT() {
  const SpeechRecognition =
    window.SpeechRecognition ||
    window.webkitSpeechRecognition;

  if (!SpeechRecognition) {
    alert("Speech recognition is not supported in this browser.");
    return;
  }

  recognition = new SpeechRecognition();

  recognition.lang =
    document.getElementById("sttLanguage").value;

  recognition.continuous = true;
  recognition.interimResults = true;

  recognition.onresult = function(event) {
    let finalText = "";
    let interimText = "";

    for (let i = 0; i < event.results.length; i++) {
      const transcript = event.results[i][0].transcript;

      if (event.results[i].isFinal) {
        finalText += transcript + " ";
      } else {
        interimText += transcript;
      }
    }

    document.getElementById("sttOutput").value =
      finalText + interimText;
  };

  recognition.onerror = function(event) {
    document.getElementById("sttStatus").textContent =
      "Error: " + event.error;
  };

  recognition.onend = function() {
    document.getElementById("sttStatus").textContent =
      "Recognition stopped.";
  };

  recognition.start();

  document.getElementById("sttStatus").textContent =
    "Listening...";
}

function stopSTT() {
  if (recognition) {
    recognition.stop();
  }
}

function copySTT() {
  const text = document.getElementById("sttOutput").value;

  navigator.clipboard.writeText(text)
    .then(() => alert("Captions copied!"))
    .catch(() => alert("Please copy the text manually."));
}

function sendSTTToCaption() {
  document.getElementById("captionText").value =
    document.getElementById("sttOutput").value;

  showCaption();
}
</script>

