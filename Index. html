<div class="panel">
  <h2>📤 Export Video</h2>

  <p class="muted">
    Export your video using your browser's recording feature.
  </p>

  <label>Export Quality</label>
  <select id="exportQuality" style="width:100%">
    <option value="4800000">1080p — High Quality</option>
    <option value="2500000">720p — Medium Quality</option>
    <option value="1000000">480p — Low Quality</option>
  </select>

  <div class="actions">
    <button class="primary" onclick="startExport()">
      🔴 Start Export
    </button>

    <button onclick="stopExport()">
      ⏹ Stop Export
    </button>
  </div>

  <p id="exportStatus" class="muted">
    Ready to export.
  </p>
</div>

<script>
let exportRecorder;
let exportStream;
let exportChunks = [];

function startExport() {
  const video = document.getElementById("videoPreview");

  if (!video.src || !video.duration) {
    alert("Import a video first.");
    return;
  }

  if (!video.captureStream) {
    alert("Your browser does not support video recording export.");
    return;
  }

  exportStream = video.captureStream();

  const bitrate =
    Number(document.getElementById("exportQuality").value);

  exportChunks = [];

  const mimeType = MediaRecorder.isTypeSupported(
    "video/webm;codecs=vp9"
  ) ? "video/webm;codecs=vp9" : "video/webm";

  exportRecorder = new MediaRecorder(exportStream, {
    mimeType: mimeType,
    videoBitsPerSecond: bitrate
  });

  exportRecorder.ondataavailable = function(event) {
    if (event.data.size > 0) {
      exportChunks.push(event.data);
    }
  };

  exportRecorder.onstop = function() {
    const blob = new Blob(exportChunks, {
      type: exportRecorder.mimeType
    });

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = "blaze-studio-export.webm";
    link.click();

    document.getElementById("exportStatus").textContent =
      "Export finished. Your WebM download should begin.";

    exportStream.getTracks().forEach(track => track.stop());
  };

  video.currentTime = 0;
  video.play();

  exportRecorder.start();

  document.getElementById("exportStatus").textContent =
    "Exporting video...";

  video.onended = function() {
    stopExport();
  };
}

function stopExport() {
  if (exportRecorder &&
      exportRecorder.state === "recording") {
    exportRecorder.stop();
  }

  const video = document.getElementById("videoPreview");
  video.pause();
}
</script>

